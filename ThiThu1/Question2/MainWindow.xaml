<Window x:Class="Question2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Question2"
        mc:Ignorable="d"
        Title="Menu Item Management" Height="600" Width="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- FILTER AREA -->
        <GroupBox Grid.Row="0" Header="FILTER AREA" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cboFilterCategory" Width="220" Height="24"
                          DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"
                          VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Text="Kitchen:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cboFilterKitchen" Width="220" Height="24"
                          DisplayMemberPath="KitchenName" SelectedValuePath="KitchenId"
                          VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <Button x:Name="btnFilter" Content="Filter" Width="80" Height="24"
                        Margin="0,0,10,0" Click="btnFilter_Click"/>
                <Button x:Name="btnClearFilter" Content="Clear Filter" Width="80" Height="24"
                        Click="btnClearFilter_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- MENU ITEM LIST -->
        <GroupBox Grid.Row="1" Header="MENU ITEM LIST" Padding="10" Margin="0,0,0,10">
            <DataGrid x:Name="dgMenuItems" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MenuItemId" Binding="{Binding MenuItemId}" Width="80"/>
                    <DataGridTextColumn Header="ItemName" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="ItemCode" Binding="{Binding ItemCode}" Width="100"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="PreparationMinutes" Binding="{Binding PreparationMinutes}" Width="120"/>
                    <DataGridTextColumn Header="CategoryName" Binding="{Binding CategoryName}" Width="120"/>
                    <DataGridTextColumn Header="KitchenName" Binding="{Binding KitchenName}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ADD NEW MENU ITEM -->
        <GroupBox Grid.Row="2" Header="ADD NEW MENU ITEM" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ItemName:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="txtItemName" Grid.Row="0" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,0,20,8"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="ItemCode:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="txtItemCode" Grid.Row="0" Grid.Column="3" Height="24" VerticalContentAlignment="Center" Margin="0,0,20,8"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Price:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="txtPrice" Grid.Row="0" Grid.Column="5" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                <!-- Row 1 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="PreparationMinutes:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="txtPreparationMinutes" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,0,20,8"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Category:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox x:Name="cboAddCategory" Grid.Row="1" Grid.Column="3" Height="24"
                          DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"
                          VerticalContentAlignment="Center" Margin="0,0,20,8"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Kitchen:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox x:Name="cboAddKitchen" Grid.Row="1" Grid.Column="5" Height="24"
                          DisplayMemberPath="KitchenName" SelectedValuePath="KitchenId"
                          VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                <!-- Row 2: Buttons -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="btnAddMenuItem" Content="Add Menu Item" Width="105" Height="26"
                            Margin="0,0,10,0" Click="btnAddMenuItem_Click"/>
                    <Button x:Name="btnClearForm" Content="Clear Form" Width="90" Height="26"
                            Click="btnClearForm_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
